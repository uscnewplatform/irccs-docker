# Dominio pubblico Zammad, terminazione SSL fatta da irccs-httpd (vedi
# httpd-config/irccs.conf, VirtualHost dedicato)
ZAMMAD_FQDN=CHANGE_ME
NGINX_SERVER_NAME=CHANGE_ME

# httpd fa gia' SSL offload e passa X-Forwarded-Proto: https
RAILS_TRUSTED_PROXIES=irccs-httpd-dashboard,172.16.0.0/12
# Zammad >= 7.1/7.2: lo schema e' deciso solo dal nginx interno, non dal proxy
# davanti (Forwarded/X-Forwarded-Ssl vengono azzerati). Senza, zammad-nginx e
# zammad-websocket vedono http -> cookie Secure non scritto -> CSRF perenne.
NGINX_SERVER_SCHEME=https

# Postgres
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=CHANGE_ME

TZ=Europe/Rome
