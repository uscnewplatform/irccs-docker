// ==========================================================================
// LOGGING (attivo) — raccolta log da tutti i container Docker sull'host
// (app stack + zammad, indipendentemente dalla rete: discovery via socket).
// ==========================================================================

discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs_integrations_docker" {
      targets = []

      rule {
          source_labels = ["__meta_docker_container_name"]
          regex = "/(.*)"
          target_label = "container_name"
      }

     rule {
        target_label = "instance"
        replacement  = constants.hostname
    }

}

// Pipeline di processing log: estrae campi logfmt (kind/service_name/app) e
// redige pattern PII noti (email, codice fiscale IT, IBAN) prima dello storage
// in Loki. Mitigazione best-effort: non sostituisce audit del logging applicativo.
loki.process "logs_process_client" {
  forward_to = [loki.write.logs_write_client.receiver]

  // Redazione PII SEMPRE per prima: deve applicarsi anche se il log non e'
  // in formato logfmt (lo stage.logfmt sotto fallisce silenziosamente sui
  // log non strutturati, ma non deve mai bloccare la redazione).
  // stage.replace non riscrive la entry in questa versione di Alloy (verificato
  // empiricamente): si usa invece regex+template+output, pattern equivalente
  // ma affidabile.

  stage.regex {
    expression = "(?s)(?P<redacted>.*)"
  }

  stage.template {
    source   = "redacted"
    template = "{{ regexReplaceAll `(?i)[A-Z]{6}[0-9LMNPQRSTUV]{2}[A-EHLMPRT][0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{3}[A-Z]` .Value `[REDACTED_CF]` }}"
  }

  stage.template {
    source   = "redacted"
    template = "{{ regexReplaceAll `\\b[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}\\b` .Value `[REDACTED_IBAN]` }}"
  }

  stage.output {
    source = "redacted"
  }

  // logfmt si applica solo ai container che effettivamente loggano in quel formato
  // (lo stack di monitoring stesso). Tutti gli altri (microservizi Quarkus con
  // quarkus-logging-json, Zammad/Rails) mandano JSON: applicarci stage.logfmt fa fallire
  // il parser con "unexpected '\"'" su ogni riga, spammando i log di Alloy (e
  // potenzialmente falsando l'alert sul tasso di errore). Whitelist esplicita invece di
  // un line-filter regex: LogQL non accetta `\{` come char escape nella stringa selector
  // (provato, "invalid char escape" al parsing), quindi matchare "non inizia con {" non
  // è praticabile qui.
  stage.match {
      selector = "{container_name=~\"irccs-(loki|grafana|alloy)\"}"

      stage.logfmt {
          mapping = { "kind" = "", "service_name" = "", "app" = "" }
      }
  }

  // Log dal Faro receiver (frontend, src/faro.ts): non hanno container_name
  // (non arrivano da loki.source.docker), quindi il match sopra li esclude e
  // "kind" resta fermo al valore statico "frontend" impostato in
  // faro.receiver.extra_log_labels. I dashboard di frontend-application.json
  // filtrano pero' su kind="measurement"/"exception" (valore reale scritto nel
  // body del log da Faro SDK): serve un secondo match dedicato per estrarlo.
  stage.match {
      selector = "{app=\"irccs-react-dashboard\"}"

      stage.logfmt {
          mapping = { "kind" = "", "service_name" = "" }
      }
  }

  stage.labels {
      values = { "kind" = "kind", "service_name" = "service_name", "app" = "app" }
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.linux.targets
  relabel_rules = discovery.relabel.logs_integrations_docker.rules
  forward_to = [loki.process.logs_process_client.receiver]
}

// Riceve log/errori dal frontend React (src/faro.ts, @grafana/faro-web-sdk).
// Solo logs: le trace non sono abilitate lato client (Tempo non deployato,
// fase 2) quindi non serve un output traces qui.
faro.receiver "integrations_app_agent_receiver" {
	// Ricevitore condiviso da piu' app frontend (dashboard React, PWA
	// Flutter). "app" resta statico per non rompere le dashboard/query
	// Loki esistenti (frontend-application.json usa label_values(app), lo
	// stage.match sotto seleziona app="irccs-react-dashboard"). "app_name"
	// (stringa vuota = riconosciuto da Alloy) si popola invece dal campo
	// app.name del payload Faro di ciascun client, per distinguere davvero
	// dashboard e PWA senza toccare le dashboard esistenti.
	extra_log_labels = {
		app      = "irccs-react-dashboard",
		app_name = "",
		kind     = "frontend",
	}

	server {
		listen_address           = "0.0.0.0"
		listen_port              = env("AGENT_PORT_APP_RECEIVER")
		cors_allowed_origins     = ["*"]
		api_key                  = env("AGENT_KEY_APP_RECEIVER")
		max_allowed_payload_size = "10MiB"

		rate_limiting {
			rate = 50
		}
	}

	sourcemaps { }

	output {
		logs = [loki.process.logs_process_client.receiver]
	}
}

loki.write "logs_write_client" {
	endpoint {
		url = format("http://%s:%s/loki/api/v1/push", env("LOKI_HOST"), env("LOKI_PORT"))
	}
	external_labels = {
        }
}

loki.write "logs_write_server" {
	endpoint {
		url = format("http://%s:%s/loki/api/v1/push", env("LOKI_HOST"), env("LOKI_PORT"))
	}
	external_labels = {
        }
}

loki.source.syslog "local" {
  listener {
    address  = "0.0.0.0:51893"
    labels   = { component = "loki.source.syslog", protocol = "tcp" }
  }

  listener {
    address  = "0.0.0.0:51898"
    protocol = "udp"
    labels   = { component = "loki.source.syslog", protocol = "udp" }
  }

  forward_to = [loki.write.logs_write_server.receiver]
}

logging {
	level = "info"
}

// Enable live debugging features (empty config means use defaults)
livedebugging {
  enabled = true
}
