# Copy this file to `.env` and fill with secure values.

# ============================================================
# Image versions
# ============================================================
# Infrastructure
POSTGRES_KEYCLOAK_VERSION=17.4
POSTGRES_HAPI_VERSION=16.8
KEYCLOAK_IMAGE_VERSION=26.0.5
HAPI_IMAGE_VERSION=v8.0.0
REDIS_VERSION=7.0-rc

# Microservices (Nexus) — aggiorna al tag del rilascio corrente
IRCCS_CLINICAL_REASONING_VERSION=CHANGE_ME_VERSION
IRCCS_AUTH_VERSION=CHANGE_ME_VERSION
IRCCS_NOTIFICATION_VERSION=CHANGE_ME_VERSION
IRCCS_PRACTITIONER_VERSION=CHANGE_ME_VERSION
IRCCS_CENTRO_RICERCA_VERSION=CHANGE_ME_VERSION
IRCCS_STUDIO_CLINICO_VERSION=CHANGE_ME_VERSION
IRCCS_ANAGRAFICA_VERSION=CHANGE_ME_VERSION
IRCCS_TAC_VERSION=CHANGE_ME_VERSION
IRCCS_ZAMMAD_VERSION=CHANGE_ME_VERSION
IRCCS_WEBPUSH_VERSION=CHANGE_ME_VERSION
IRCCS_PATIENT_INTERVIEW_VERSION=CHANGE_ME_VERSION
IRCCS_HTTPD_VERSION=CHANGE_ME_VERSION
IRCCS_ANTORA_DOCS_VERSION=CHANGE_ME_BRANCH_OR_TAG

# Keycloak
KEYCLOAK_ADMIN=admin@example.com
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG
KEYCLOAK_CLIENT_ID==CHANGE_ME_CLIENT_ID
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM
KEYCLOAK_REALM==CHANGE_ME_REALM_NAME

# Keycloak DB (per evitare password in keycloak.conf)
KC_HOSTNAME=CHANGE_ME_HOSTNAME
KC_HOSTNAME_URL=CHANGE_ME_HOSTNAME

# Postgres (Keycloak)
POSTGRES_KEYCLOAK_PASSWORD=CHANGE_ME_STRONG
POSTGRES_KEYCLOAK_DB=CHANGE_ME_DB
POSTGRES_KEYCLOAK_USER=CHANGE_ME_USER

# Postgres (HAPI FHIR)
HAPI_DB_USER=CHANGE_ME_DB_USER
HAPI_DB_PASSWORD=CHANGE_ME_DB_PSW
HAPI_DB_NAME=CHANGE_ME_DB_NAME

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG

# JWT
JWT_SECRET=CHANGE_ME_64_HEX_OR_BASE64

#OIDC token

OIDC_TOKEN_ISSUER=CHANGE_ME

#ZAMMAD CONFIG
ZAMMAD_TOKEN_SERVICE=CHANGE_ME
ZAMMAD_BASE_URL=CHANGE_ME
ZAMMAD_ADMIN_EMAIL=CHANGE_ME
ZAMMAD_INTERVAL_POLLING=CHANGE_ME

#TOTP NOTIFICATION PROPS
quarkus.mailer.from=noreply-pascale@admin.it
quarkus.mailer.host=smtp.gmail.com
quarkus.mailer.port=587
quarkus.mailer.start-tls=DISABLED
quarkus.mailer.username=i3.irccs.test@gmail.com
quarkus.mailer.password=bzvzpeuvqjycgdhi
quarkus.mailer.mock=false

# Web Push VAPID keys — generare con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# ── PWA Backend ───────────────────────────────────────────────────────────────
# OBBLIGATORIO: openssl rand -hex 32
PWA_SECRET_KEY=CHANGE_ME_32_HEX

# staging = no ENFORCE_HTTPS richiesto; production = richiede ENFORCE_HTTPS=true
PWA_ENVIRONMENT=staging
PWA_ENFORCE_HTTPS=false

# Origini CORS ammesse dal browser (porta admin + eventuale dominio pubblico)
# Esempio: http://10.40.10.121:8092,https://pwa.irccs.infocube.it
PWA_CORS_ORIGINS=CHANGE_ME_CORS_ORIGINS

# Web Push PWA (opzionale — abilitare nel compose se serve)
# docker exec irccs-pwa-backend python generate_vapid_keys.py
# WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME
# WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME
