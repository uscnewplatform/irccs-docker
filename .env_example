# Copy this file to `.env` and fill with secure values.

# ============================================================
# Image versions
# ============================================================
# Infrastructure
POSTGRES_KEYCLOAK_VERSION=17.4
POSTGRES_HAPI_VERSION=16.8
KEYCLOAK_IMAGE_VERSION=26.0.5
HAPI_IMAGE_VERSION=v8.0.0
REDIS_VERSION=7.0-rc

# Microservices (Nexus) — aggiorna al tag del rilascio corrente
IRCCS_CLINICAL_REASONING_VERSION=CHANGE_ME_VERSION
IRCCS_AUTH_VERSION=CHANGE_ME_VERSION
IRCCS_NOTIFICATION_VERSION=CHANGE_ME_VERSION
IRCCS_PRACTITIONER_VERSION=CHANGE_ME_VERSION
IRCCS_CENTRO_RICERCA_VERSION=CHANGE_ME_VERSION
IRCCS_STUDIO_CLINICO_VERSION=CHANGE_ME_VERSION
IRCCS_ANAGRAFICA_VERSION=CHANGE_ME_VERSION
IRCCS_TAC_VERSION=CHANGE_ME_VERSION
IRCCS_ZAMMAD_VERSION=CHANGE_ME_VERSION
IRCCS_WEBPUSH_VERSION=CHANGE_ME_VERSION
IRCCS_PATIENT_INTERVIEW_VERSION=CHANGE_ME_VERSION
IRCCS_HTTPD_VERSION=CHANGE_ME_VERSION
# Branch dell'immagine irccs-httpd-dashboard da pullare da Nexus (default: develop se
# assente). Utile per testare un'immagine buildata da un feature branch non ancora
# mergiato, es: IRCCS_HTTPD_BRANCH=feature/audit-event-store-isolato
#IRCCS_HTTPD_BRANCH=develop
IRCCS_ANTORA_DOCS_VERSION=CHANGE_ME_BRANCH_OR_TAG

# Keycloak
KEYCLOAK_ADMIN=admin@example.com
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG
KEYCLOAK_CLIENT_ID==CHANGE_ME_CLIENT_ID
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM
KEYCLOAK_REALM==CHANGE_ME_REALM_NAME

# Keycloak DB (per evitare password in keycloak.conf)
KC_HOSTNAME=CHANGE_ME_HOSTNAME
KC_HOSTNAME_URL=CHANGE_ME_HOSTNAME

# Postgres (Keycloak)
POSTGRES_KEYCLOAK_PASSWORD=CHANGE_ME_STRONG
POSTGRES_KEYCLOAK_DB=CHANGE_ME_DB
POSTGRES_KEYCLOAK_USER=CHANGE_ME_USER

# Postgres (HAPI FHIR)
HAPI_DB_USER=CHANGE_ME_DB_USER
HAPI_DB_PASSWORD=CHANGE_ME_DB_PSW
HAPI_DB_NAME=CHANGE_ME_DB_NAME

# Postgres + HAPI dedicati all'audit trail (store fisicamente separato)
HAPI_AUDIT_DB_USER=CHANGE_ME_AUDIT_DB_USER
HAPI_AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_DB_PSW
HAPI_AUDIT_DB_NAME=CHANGE_ME_AUDIT_DB_NAME
# CORS / external references HAPI (difesa in profondita' - HAPI non e' browser-facing)
# In produzione: HAPI_CORS_ALLOWED_ORIGIN=https://<dominio-dashboard>.
# HAPI_ALLOW_EXTERNAL_REFERENCES=false verificato 2026-08-31: nessun flusso applicativo
# usa Reference con URL assoluti esterni (vedi hapi-fhir-config/application.yaml).
HAPI_CORS_ALLOWED_ORIGIN=*
HAPI_ALLOW_EXTERNAL_REFERENCES=false

# --- Interruttori interceptor di audit (default: tutti attivi) ------------------
# Servono all'istanza irccs-hapi-audit (e a irccs-hapi-fhir finche' monta gli
# interceptor). Impostare "false" solo per troubleshooting / ambienti effimeri:
# disattivarli indebolisce l'immodificabilita' dell'audit trail.
# Il modo pulito per disattivare del tutto un interceptor resta toglierlo da
# hapi.fhir.custom-interceptor-classes nel relativo application.yaml.
#   IRCCS_AUDIT_APPEND_ONLY_ENABLED=true   # nega update/delete/expunge su AuditEvent
#   IRCCS_AUDIT_HASH_CHAIN_ENABLED=true    # extension audit-chain-prev/hash tamper-evident
# NB: i trigger Postgres (setup/audit_db_protection.sql) sono un layer indipendente,
# si disattivano non installandoli / con DROP TRIGGER, non da qui.

# --- Verifica continua integrità hash-chain (container irccs-audit-integrity) ---
# Default sensati; override solo per ambienti particolari.
#   AUDIT_INTEGRITY_INTERVAL=900       # secondi tra una verifica incrementale e l'altra
#   AUDIT_INTEGRITY_FULL_EVERY=96      # ogni N cicli fa una scansione full (96*900s ~ 24h)
#   AUDIT_INTEGRITY_EXTRA_ARGS=        # arg extra per verify_audit_hash_chain.py (es. --token ...)

# --- Riconciliazione risorse orfane (verify_audit_coverage.py, stesso container/ciclo) ---
# Copre il gap residuo del fail-closed sincrono: un crash tra il write clinico e
# il write audit non viene rilevato in tempo reale, solo entro il prossimo giro.
#   AUDIT_COVERAGE_GRACE_SECONDS=300   # secondi prima di considerare "orfana" una risorsa critica
#   AUDIT_COVERAGE_EXTRA_ARGS=         # arg extra per verify_audit_coverage.py (es. --critical-types ...)

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG

# JWT
JWT_SECRET=CHANGE_ME_64_HEX_OR_BASE64

#OIDC token

OIDC_TOKEN_ISSUER=CHANGE_ME

# Identifier.system dei Questionnaire trattati come PRO (studio-clinico/CarePlanController,
# webpush/WebPushService) - CSV, default se assente = EORTC,PROCTC,PROS,PATIENT_QUESTIONNAIRE
IRCCS_PRO_QUESTIONNAIRE_SYSTEMS=EORTC,PROCTC,PROS,PATIENT_QUESTIONNAIRE

#ZAMMAD CONFIG
ZAMMAD_TOKEN_SERVICE=CHANGE_ME
ZAMMAD_BASE_URL=CHANGE_ME
ZAMMAD_ADMIN_EMAIL=CHANGE_ME
ZAMMAD_INTERVAL_POLLING=CHANGE_ME

#TOTP NOTIFICATION PROPS
quarkus.mailer.from=noreply-pascale@admin.it
quarkus.mailer.host=smtp.gmail.com
quarkus.mailer.port=587
quarkus.mailer.start-tls=DISABLED
quarkus.mailer.username=i3.irccs.test@gmail.com
quarkus.mailer.password=bzvzpeuvqjycgdhi
quarkus.mailer.mock=false

# Web Push VAPID keys — generare con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# ── PWA Backend ───────────────────────────────────────────────────────────────
# OBBLIGATORIO: openssl rand -hex 32
PWA_SECRET_KEY=CHANGE_ME_32_HEX

# staging = no ENFORCE_HTTPS richiesto; production = richiede ENFORCE_HTTPS=true
PWA_ENVIRONMENT=staging
PWA_ENFORCE_HTTPS=false

# Origini CORS ammesse dal browser (porta admin + eventuale dominio pubblico)
# Esempio: http://10.40.10.121:8092,https://pwa.irccs.infocube.it
PWA_CORS_ORIGINS=CHANGE_ME_CORS_ORIGINS

# Vuoto: Apache strippa gia' il prefisso /quest-inspire-api (ProxyPass senza
# path sul target, vedi httpd-config/irccs.conf). Se il backend e' esposto
# senza reverse proxy davanti (es. docker-compose.pwa.yml standalone in
# irccs-pwa con nginx tutto-in-uno) usare invece /quest-inspire-api.
API_BASE_PATH=

# Dominio pubblico HTTPS (non l'hostname interno del container httpd: Apache
# non ascolta su porta 80 e il certificato TLS e' emesso per questo dominio,
# non per l'hostname docker interno). Usato per le chiamate FHIR verso il PJS.
IRCCS_API_BASE_URL=https://CHANGE_ME_PUBLIC_DOMAIN

# Endpoint diretto del microservizio auth (bypassa Apache, traffico interno
# container-to-container).
IRCCS_AUTH_TOKEN_URL=http://irccs-auth:8080/fhir/auth/users/token

# Deve combaciare col claim "iss" dei token emessi da Keycloak: e' il dominio
# pubblico visto dal client, non l'hostname interno (altrimenti la
# validazione del token PJS fallisce sempre con 401). Nota: in questo
# ambiente Keycloak espone i realm senza prefisso /backoffice/ (vedi
# ProxyPass /authServer in httpd-config/irccs.conf).
IRCCS_TOKEN_ISSUER=https://CHANGE_ME_PUBLIC_DOMAIN/backoffice/realms/pascale

# Hostname pubblico consentito nel link action-token del QR PJS.
IRCCS_ACTION_TOKEN_HOSTS=CHANGE_ME_PUBLIC_DOMAIN

# Web Push PWA (opzionale — abilitare nel compose se serve)
# docker exec irccs-pwa-backend python generate_vapid_keys.py
# WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME
# WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME
# WEB_PUSH_SUBJECT=mailto:admin@irccs.it

# Mail notifications example for HTML EMAIL
APP_PUBLIC_BASE_URL=https://irccs.staging.infocube.it
APP_HELP_DESK_EMAIL=helpdesk-pj@istitutotumori.na.it
#APP_VERIFIED_REDIRECT_URL=https://www.test.it/verified     # FE redirect after verify click
#APP_SET_PASSWORD_URL=https://www.test.it /set-password      # FE page for setup/reset-password emails

# ============================================================
# Monitoring (docker-compose-monitoring.yaml — opzionale, Grafana/Loki/Alloy)
# ============================================================
GRAFANA_VERSION=12.4.0-22081664032
# Porta host diretta (solo se scommenti "ports:" su grafana in
# docker-compose-monitoring.yaml - di default Grafana e' raggiungibile solo
# via proxy httpd su /grafana, questa var non serve nel flusso normale).
GRAFANA_PORT=3001
GRAFANA_DOMAIN=CHANGE_ME_HOSTNAME
GRAFANA_HOME_PATH=/usr/share/grafana

# Deve combaciare ESATTAMENTE con protocollo/host/subpath che il browser usa
# per accedere, altrimenti "origin not allowed" su login e ogni azione che
# scrive (i GET passano comunque - falsa impressione "quasi funziona").
#
# Caso normale, via proxy httpd (TLS terminato a monte, vedi ProxyPreserveHost
# in httpd-config/irccs.conf):
GRAFANA_ROOT_URL=https://CHANGE_ME_HOSTNAME/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true
#
# Caso alternativo, porta diretta (debug/isolamento problemi proxy - richiede
# anche di scommentare "ports:" su grafana nel compose e impostare GRAFANA_PORT):
#GRAFANA_ROOT_URL=http://CHANGE_ME_IP_O_HOST:3001/
#GRAFANA_SERVE_FROM_SUB_PATH=false

GRAFANA_CONFIG_FILE=grafana.ini
GRAFANA_CONFIG_PATH=/etc/grafana-config
# ATTENZIONE: file, non cartella - stesso bug di LOKI/ALLOY_CONFIG_PATH_LOCAL sotto
# (il volume nel compose non la combina con GRAFANA_CONFIG_FILE lato host, solo lato
# container). Lasciata come cartella: "failed to parse grafana.ini: is a directory".
GRAFANA_CONFIG_PATH_LOCAL=./monitoring-config/grafana.ini

GRAFANA_DATASOURCES_PATH=/etc/grafana/provisioning/datasources
GRAFANA_DATASOURCES_PATH_LOCAL=./monitoring-config/datasource

GRAFANA_DASHBOARDS_PROVISIONING_PATH=/etc/grafana/provisioning/dashboards
GRAFANA_DASHBOARDS_PROVISIONING_PATH_LOCAL=./monitoring-config/dashboard-provisioning
GRAFANA_DASHBOARDS_PATH=/var/lib/grafana/dashboards
GRAFANA_DASHBOARDS_PATH_LOCAL=./monitoring-config/dashboards

# Alerting-as-code (regole irccs-audit-* incluse) — cartella gia' nel repo
# (monitoring-config/alerting/: rules.yaml, policies.yaml, contactpoints.yaml,
# timeintervals.yaml). Mancava da questo template: senza questa coppia
# docker-compose v1 genera un bind mount invalido ('.:.:rw', ContainerConfig-style
# errore "mount path must be absolute") perche' entrambe le variabili risultano
# vuote invece che assenti.
GRAFANA_ALERTING_PATH=/etc/grafana/provisioning/alerting
GRAFANA_ALERTING_PATH_LOCAL=./monitoring-config/alerting

# SMTP per le notifiche di alert Grafana (contactpoints.yaml)
GF_SMTP_HOST=CHANGE_ME_SMTP_HOST:587
GF_SMTP_FROM=grafana-alerts@irccs.it
ALERT_EMAIL_TO=CHANGE_ME_DESTINATARIO
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG
GF_USERS_ALLOW_SIGN_UP=false

# Loki
LOKI_CONFIG_FILE=loki-config.yml
LOKI_CONFIG_PATH=/etc/loki
# ATTENZIONE: deve puntare al FILE (non alla cartella) - il volume nel compose
# non lo combina con LOKI_CONFIG_FILE lato host, solo lato container. Stesso
# errore ("mount path must be absolute" / errore mount directory-su-file) visto
# oggi con ALLOY_CONFIG_PATH_LOCAL se lasciata come semplice directory.
LOKI_CONFIG_PATH_LOCAL=./monitoring-config/loki-config.yml

# Alloy (agente di raccolta log/metriche -> Loki/Grafana)
AGENT_PORT=12345
ALLOY_CONFIG_FILE=config.alloy
ALLOY_CONFIG_PATH=/etc/alloy
# Stessa attenzione di LOKI_CONFIG_PATH_LOCAL sopra: file, non cartella.
ALLOY_CONFIG_PATH_LOCAL=./monitoring-config/config.alloy
