# Configurazione backup DB (HAPI FHIR + Keycloak + audit trail). Copiare come
# backup/.env.backup (NON committare il file reale: contiene path e destinazioni
# specifiche dell'host).
# Le credenziali DB (POSTGRES_KEYCLOAK_*, HAPI_DB_*, HAPI_AUDIT_DB_USER) sono
# lette dal .env principale della stack (stesso file usato da docker-compose.yaml)
# — non duplicarle qui. Eccezione: HAPI_AUDIT_DB_NAME non esiste nel .env
# principale (nome DB "hapiaudit" hardcoded in docker-compose.yaml) — default
# gestito da backup_db.sh, override qui solo se necessario.

# Root locale dove risiedono staging (plaintext temporaneo) e archivio cifrato.
BACKUP_ROOT=/opt/irccs-backup

# File di log letto da Alloy (loki.source.file) per l'ingestione su Grafana.
# Deve stare sotto un path incluso nel mount /rootfs di Alloy (gia' presente
# in prod, vedi docker-compose-monitoring.yaml) — /var/log va sempre bene.
BACKUP_LOG_FILE=/var/log/irccs-backup/backup.log

# Retention GFS (Grandfather-Father-Son) sull'archivio cifrato locale.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6

# Chiavi pubbliche age per cifratura dump prima della ritenzione/offsite.
# Raccomandato: almeno 2 recipient generati da 2 custodi indipendenti, che NON
# condividono l'host di backup (es. un referente infra + un referente
# sicurezza/DPO, ciascuno con la propria chiave privata in cassaforte/vault
# separati). Se una delle due chiavi private va persa, l'altra resta comunque
# in grado di decifrare tutti i backup — perdere l'UNICA chiave (recipient
# singolo) renderebbe illeggibili TUTTI i backup passati e futuri, un single
# point of failure inaccettabile per un sistema il cui scopo e' la resilienza.
# Generare ciascuna chiave con: age-keygen -o <path-fuori-da-questo-host>/irccs-backup-key-<custode>.txt
# Elenco separato da VIRGOLE, SENZA virgolette (importante: questo file viene
# letto sia con `source` in bash sull'host, sia passato a `docker run
# --env-file` per il container — il formato env-file di Docker non fa parsing
# shell, quindi virgolette attorno al valore diventerebbero caratteri LETTERALI
# nel container, rompendo il parsing delle chiavi age. Le virgole invece
# funzionano identiche in entrambi i casi, nessun quoting necessario):
BACKUP_AGE_RECIPIENTS=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,age1yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Retrocompatibilita': se BACKUP_AGE_RECIPIENTS non e' definita, gli script
# usano BACKUP_AGE_RECIPIENT (singolare, vecchio formato a singolo recipient).

# Destinazione offsite via rclone (remote:path) o rsync (user@host:/path).
# Configurare il remote rclone con `rclone config` prima di abilitare il push offsite.
BACKUP_OFFSITE_METHOD=rclone   # rclone | rsync | none
BACKUP_OFFSITE_TARGET=offsite-remote:irccs-backup/

# Margine di sicurezza prima che la retention GFS cancelli DAVVERO un file
# dall'offsite (solo rclone): un file fuori dal set "da tenere" diventa
# "candidato" ma resta sul remote finche' non e' rimasto candidato per almeno
# N giorni CONSECUTIVI. Da' tempo a un operatore di accorgersi di un bug nel
# calcolo della retention (o di un alert) prima che la copia offsite — l'ultima
# linea di difesa — sparisca nella stessa notte in cui sparisce quella locale.
# La retention locale resta immediata (nessuna grazia, gia' ricostruibile
# dall'offsite).
BACKUP_OFFSITE_DELETE_GRACE_DAYS=3

# Container postgres scratch usato da verify_restore.sh (isolato, rete dedicata).
BACKUP_VERIFY_IMAGE_HAPI=postgres:${POSTGRES_HAPI_VERSION:-16.8}
BACKUP_VERIFY_IMAGE_KEYCLOAK=postgres:${POSTGRES_KEYCLOAK_VERSION:-17.4}
# hapi-audit usa lo stesso schema/immagine di hapi: eredita BACKUP_VERIFY_IMAGE_HAPI
# se non impostata esplicitamente.
# BACKUP_VERIFY_IMAGE_HAPI_AUDIT=postgres:16.8

# Chiave privata age per la verifica periodica di integrita' dell'archivio
# (scripts/verify_archive_integrity.sh, timer settimanale) — l'unico script
# che deve poter decifrare direttamente su questo host. RACCOMANDATO: generare
# una chiave DEDICATA solo a questo scopo (NON una delle chiavi dei custodi
# reali elencate sopra in BACKUP_AGE_RECIPIENTS), e aggiungerla anch'essa come
# recipient in piu' (non in sostituzione) in BACKUP_AGE_RECIPIENTS. Se questa
# chiave dedicata trapela, basta rigenerarla e ruotarla sui backup futuri,
# senza dover revocare/coinvolgere le chiavi dei custodi usate per il vero
# disaster recovery. Se invece si riusa qui una chiave custode, compromettere
# questo host vanifica silenziosamente il vantaggio del multi-recipient.
# Generare con: age-keygen -o <path>/irccs-backup-verify-key.txt
# BACKUP_VERIFY_KEY_FILE=/etc/irccs-backup-key/irccs-backup-verify-key.txt

# Nomi container postgres da cui fare pg_dump. Default = nomi usati in prod
# (container_name esplicito in irccs-docker/docker-compose.yaml). Su pascale-local
# sono prefissati (es. pascale-local-postgres-hapi, pascale-local-postgres-keycloak,
# pascale-local-postgres-hapi-audit) — scommentare e adattare per i test locali.
# BACKUP_HAPI_CONTAINER=pascale-local-postgres-hapi
# BACKUP_KEYCLOAK_CONTAINER=pascale-local-postgres-keycloak
# BACKUP_HAPI_AUDIT_CONTAINER=pascale-local-postgres-hapi-audit
